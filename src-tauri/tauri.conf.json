{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitGlade",
  "version": "0.1.1",
  "identifier": "io.github.yyyzl.gitglade",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitGlade",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 540,
        "backgroundColor": "#282c34"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Explore Git branches, commits, and file changes",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["English", "SimpChinese"],
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "../skills/gitglade/": "skills/gitglade/",
      "../bin/": "bin/",
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../docs/zh-CN/third-party-notices.md": "docs/zh-CN/third-party-notices.md"
    }
  }
}
